{
    "name": "padosoft/laravel-flow-connect",
    "description": "Triggers and nodes for padosoft/laravel-flow: cron, event and signed-webhook triggers, plus HTTP/API, transform, condition, delay and batch graph nodes. Part of the Laravel Flow 2.0 suite.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "workflow",
        "orchestration",
        "triggers",
        "webhooks",
        "connectors",
        "laravel-flow",
        "nodes",
        "http",
        "automation"
    ],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "dragonmantank/cron-expression": "^3.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "padosoft/laravel-flow": "^2.6",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\LaravelFlowConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\LaravelFlowConnect\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\LaravelFlowConnect\\LaravelFlowConnectServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "format:test": "pint --test",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": [
            "phpunit --testsuite Unit",
            "phpunit --testsuite Contract"
        ]
    }
}
