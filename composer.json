{
    "name": "padosoft/laravel-flow-connect",
    "description": "Connector nodes and triggers for padosoft/laravel-flow: HTTP/API nodes, schedule and event triggers, signed inbound webhooks. Part of the Laravel Flow 2.0 suite.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["laravel", "workflow", "orchestration", "triggers", "webhooks", "connectors", "laravel-flow"],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "padosoft/laravel-flow": "dev-task/v2d-realtime-triggers"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../padosoft-laravel-flow",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Padosoft\\LaravelFlowConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\LaravelFlowConnect\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\LaravelFlowConnect\\LaravelFlowConnectServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "format:test": "pint --test",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": [
            "phpunit --testsuite Unit",
            "phpunit --testsuite Contract"
        ]
    }
}
